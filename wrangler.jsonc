 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "navihive",
    "main": "worker/index.ts",
    "compatibility_date": "2025-04-05",
    "assets": {
        "not_found_handling": "single-page-application"
    },
    "observability": {
        "enabled": true
    },
    // D1数据库绑定 - 注释掉，使用 Cloudflare Dashboard 中的绑定配置
    // "d1_databases": [
    //     {
    //         "binding": "DB",
    //         "database_name": "navigation-db",
    //         "database_id": "d8bca014-1175-4c2d-a57d-2fedecaa77c4"
    //     }
    // ],
    "vars": {
        "AUTH_ENABLED": "true",
        "AUTH_USERNAME": "macc",
        "AUTH_PASSWORD": "visa",
        "AUTH_SECRET": "visa"
    }
}

